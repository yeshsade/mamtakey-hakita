<%- include('partials/header', { extraCss: 'home' }) %>

<div class="home-container">
  <div class="setup-card">
    <div class="setup-icon">🏦🍬</div>
    <h1>ממתקי הכיתה</h1>
    <h2>הגדרה ראשונית</h2>
    <p>צור חשבון מנהל כדי להתחיל</p>

    <% if (error) { %>
      <div class="setup-error"><%= error %></div>
    <% } %>

    <form method="POST" action="/auth/setup">
      <div class="setup-field">
        <label>👤 שם משתמש</label>
        <input type="text" name="username" placeholder="בחר שם משתמש" required autocomplete="off">
      </div>
      <div class="setup-field">
        <label>🔒 סיסמה</label>
        <input type="password" name="password" placeholder="בחר סיסמה" required>
      </div>
      <div class="setup-field">
        <label>🔒 אימות סיסמה</label>
        <input type="password" name="password2" placeholder="הקלד שוב את הסיסמה" required>
      </div>
      <button type="submit" class="btn btn-primary setup-btn">🚀 צור חשבון והתחל</button>
    </form>
  </div>
</div>

<style>
  .setup-card {
    background: #fff;
    border-radius: 28px;
    padding: 48px 40px;
    max-width: 420px;
    width: 100%;
    text-align: center;
    box-shadow: 0 8px 32px rgba(0,0,0,0.08);
  }
  .setup-icon { font-size: 3.5rem; margin-bottom: 16px; letter-spacing: 8px; }
  .setup-card h1 { font-size: 2rem; font-weight: 800; margin-bottom: 4px; color: #1a1a2e; }
  .setup-card h2 { font-size: 1.1rem; font-weight: 400; color: #888; margin-bottom: 8px; }
  .setup-card p { font-size: 0.9rem; color: #aaa; margin-bottom: 28px; }
  .setup-error {
    background: #fef2f2; color: #dc2626; padding: 12px; border-radius: 12px;
    margin-bottom: 16px; font-size: 0.9rem;
  }
  .setup-field { text-align: right; margin-bottom: 16px; }
  .setup-field label { display: block; font-size: 0.9rem; font-weight: 600; color: #555; margin-bottom: 6px; }
  .setup-field input { width: 100%; padding: 14px 16px; font-size: 1rem; }
  .setup-btn { width: 100%; padding: 16px; font-size: 1.1rem; margin-top: 8px; }
</style>

<%- include('partials/footer', { extraJs: undefined }) %>
