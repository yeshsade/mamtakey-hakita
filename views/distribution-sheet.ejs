<%- include('partials/header', { extraCss: 'admin' }) %>

<div class="admin-page">
  <div class="admin-header">
    <span class="admin-logo">דף חלוקה יומי</span>
    <div class="admin-nav">
      <a href="/admin">חזרה לניהול</a>
    </div>
  </div>

  <div class="admin-content">
    <div class="admin-card">
      <h3>חלוקת נקודות לתלמידים</h3>
      <p style="color: #888; font-size: 0.9rem; margin-bottom: 20px;">
        הכנס כמות נקודות לכל תלמיד ולחץ "שמור הכל"
      </p>

      <table>
        <thead>
          <tr>
            <th>שם</th>
            <th>יתרה נוכחית</th>
            <th style="width: 140px;">נקודות לחלוקה</th>
          </tr>
        </thead>
        <tbody>
          <% students.forEach(function(s) { %>
            <tr>
              <td><strong><%= s.name %></strong></td>
              <td><span class="admin-badge admin-badge-balance"><%= s.balance %> נק׳</span></td>
              <td>
                <input type="number" class="dist-input" data-student-id="<%= s.id %>"
                       min="0" value="0" style="width: 100%; text-align: center;">
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>

      <div style="display: flex; gap: 12px; margin-top: 24px; justify-content: center;">
        <button class="btn btn-primary" onclick="setAll()">קבע לכולם</button>
        <button class="btn btn-success" onclick="applyDistribution()">שמור הכל</button>
      </div>
    </div>
  </div>
</div>

<script>
function setAll() {
  const amount = prompt('כמה נקודות לכל תלמיד?');
  if (amount === null) return;
  document.querySelectorAll('.dist-input').forEach(input => {
    input.value = parseInt(amount) || 0;
  });
}

async function applyDistribution() {
  const inputs = document.querySelectorAll('.dist-input');
  const distributions = [];

  inputs.forEach(input => {
    const amount = parseInt(input.value) || 0;
    if (amount > 0) {
      distributions.push({
        student_id: parseInt(input.dataset.studentId),
        amount
      });
    }
  });

  if (distributions.length === 0) {
    alert('לא הוכנסו נקודות לאף תלמיד');
    return;
  }

  const total = distributions.reduce((sum, d) => sum + d.amount, 0);
  if (!confirm(`לחלק ${total} נקודות ל-${distributions.length} תלמידים?`)) return;

  const res = await fetch('/admin/distribution-sheet/apply', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ distributions })
  });

  const data = await res.json();
  if (data.success) {
    alert('הנקודות חולקו בהצלחה!');
    location.reload();
  }
}
</script>

<%- include('partials/footer', { extraJs: undefined }) %>
