<%- include('partials/header', { extraCss: 'home' }) %>

<div class="home-container">
  <div class="card" style="max-width: 380px; width: 100%;">
    <h2 style="text-align: center; margin-bottom: 24px;">כניסת מנהל</h2>
    <% if (error) { %>
      <div style="background: #fef2f2; color: #dc2626; padding: 12px; border-radius: 10px; margin-bottom: 16px; text-align: center; font-size: 0.9rem;">
        <%= error %>
      </div>
    <% } %>
    <form method="POST" action="/auth/login">
      <div style="margin-bottom: 16px;">
        <input type="text" name="username" placeholder="שם משתמש" style="width: 100%;" required autocomplete="off">
      </div>
      <div style="margin-bottom: 24px;">
        <input type="password" name="password" placeholder="סיסמה" style="width: 100%;" required>
      </div>
      <button type="submit" class="btn btn-primary" style="width: 100%;">כניסה</button>
    </form>
    <div style="text-align: center; margin-top: 16px;">
      <a href="/" style="color: #888; font-size: 0.85rem;">חזרה לדף הראשי</a>
    </div>
  </div>
</div>

<%- include('partials/footer', { extraJs: undefined }) %>
