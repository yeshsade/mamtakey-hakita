<%- include('partials/header', { extraCss: 'store' }) %>

<div class="store-page">
  <div class="store-floating-candy">
    <span class="candy c1">🍬</span>
    <span class="candy c2">🍭</span>
    <span class="candy c3">🧁</span>
    <span class="candy c4">🍫</span>
    <span class="candy c5">🍪</span>
    <span class="candy c6">🐻</span>
    <span class="candy c7">🎀</span>
  </div>

  <div class="store-header">
    <a href="/" class="store-logo">
      <span class="store-logo-icon">🍭</span>
      <div>
        <div class="store-logo-text">חנות ממתקי הכיתה</div>
        <div class="store-logo-sub">🍬 הממתקים הכי טעימים 🍬</div>
      </div>
    </a>
    <div class="store-nav">
      <a href="/">🏠 ראשי</a>
      <a href="/bank">🏦 בנק</a>
    </div>
  </div>

  <div class="operator-badge hidden" id="operatorBadge">
    <span>🔑 מפעיל: <strong id="operatorName"></strong></span>
    <button onclick="logoutOperator()">יציאה</button>
  </div>

  <div class="store-content">
    <div class="store-scan-product">
      <div class="store-products-title">🔍 סרוק ברקוד ממתק או בחר מהרשימה</div>
      <input type="text" id="productBarcodeInput" placeholder="🔍 סריקת ברקוד..." autofocus autocomplete="off">
    </div>

    <div class="store-products-title">🍬 ממתקים זמינים</div>
    <div class="store-products-grid" id="productsGrid"></div>

    <div class="store-checkout hidden" id="checkoutSection">
      <div class="store-products-title">🛒 עגלת קניות</div>
      <div id="cartItems"></div>
      <div class="store-total-bar">
        <span class="store-total-label">🧮 סה״כ</span>
        <span class="store-total-amount"><span id="totalAmount">0</span> נק׳</span>
      </div>
      <button class="store-buy-btn" id="buyBtn" onclick="startCheckout()">💳 לתשלום</button>
    </div>
  </div>

  <!-- Student Selection Modal -->
  <div class="store-modal hidden" id="studentModal">
    <div class="store-modal-dialog">
      <h3>👦 בחר תלמיד</h3>
      <input type="text" id="studentSearchInput" placeholder="🔍 סרוק ברקוד או חפש בשם..." autocomplete="off">
      <div class="store-student-list" id="studentList"></div>
      <div class="store-selected-student hidden" id="selectedStudentInfo">
        <div class="store-selected-avatar" id="selectedAvatar">🧒</div>
        <div>
          <div class="store-selected-name" id="selectedName"></div>
          <div class="store-selected-balance">💰 יתרה: <span id="selectedBalance">0</span> נק׳</div>
        </div>
      </div>
      <div class="store-modal-actions">
        <button class="store-buy-btn" id="confirmPurchaseBtn" onclick="confirmPurchase()" disabled>💳 בחר תלמיד קודם</button>
        <button class="store-cancel-btn" onclick="closeStudentModal()">❌ ביטול</button>
      </div>
    </div>
  </div>

  <!-- New Product Modal -->
  <div class="store-modal hidden" id="newProductModal">
    <div class="store-modal-dialog">
      <div style="font-size:3rem;text-align:center;margin-bottom:8px;">🍬</div>
      <h3>ממתק חדש!</h3>
      <p style="text-align:center;color:#888;margin-bottom:16px;font-size:0.9rem;">
        הברקוד לא מוכר. הוסף מוצר חדש:
      </p>
      <input type="text" id="newProductBarcode" placeholder="ברקוד" readonly style="background:#f5f5f7;">
      <input type="text" id="newProductName" placeholder="🍫 שם הממתק" autocomplete="off">
      <input type="number" id="newProductPrice" placeholder="💰 מחיר (נקודות)" min="1" autocomplete="off">
      <div class="store-modal-actions">
        <button class="store-buy-btn" onclick="saveNewProduct()">✅ הוסף</button>
        <button class="store-cancel-btn" onclick="closeNewProductModal()">❌ ביטול</button>
      </div>
    </div>
  </div>
</div>

<script>
  window.__sessionUser = <%- JSON.stringify(typeof sessionUser !== 'undefined' ? sessionUser : null) %>;
</script>
<%- include('partials/footer', { extraJs: 'store' }) %>
