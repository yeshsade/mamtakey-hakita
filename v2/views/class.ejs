<!doctype html>
<html lang="he" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ממתקי הכיתה</title>
<link rel="stylesheet" href="/fonts/fonts.css">
<link rel="stylesheet" href="/app.css">
</head>
<body style="--h:'<%= font %>', 'Arial Hebrew', sans-serif">

<header class="top">
  <div class="hello">
    <span class="h">שלום, <%= actor.name %></span>
    <span class="role"><%= actor.role === 'teacher' ? 'מורה' : 'תורן' %></span>
  </div>
  <button class="quiet" id="logout">יציאה</button>
</header>

<nav class="tools">
  <div class="seg" role="tablist">
    <% classes.forEach(function(c){ %>
      <a class="seg-i h <%= c.id === currentId ? 'on' : '' %>" href="/class?c=<%= c.id %>"><%= c.name %></a>
    <% }); %>
  </div>
  <input class="search" id="search" type="search" placeholder="חיפוש תלמיד…" autocomplete="off">
</nav>

<div class="split">

  <!-- מימין: הכרטיס של התלמיד. תמיד פתוח. -->
  <aside class="panel" id="panel">
    <div class="hero">
      <div class="hero-top">
        <span class="p-class" id="pClass"></span>
        <span class="p-no num" id="pNo"></span>
      </div>
      <div class="p-name h" id="pName"></div>
      <div class="p-bal h num" id="pBal"></div>
      <div class="p-unit">נקודות</div>
    </div>

    <div class="stats">
      <div class="stat"><span class="s-num h num" id="sToday">0</span><span class="s-lbl">היום</span></div>
      <div class="stat"><span class="s-num h num" id="sWeek">0</span><span class="s-lbl">השבוע</span></div>
      <div class="stat"><span class="s-num h num" id="sCount">0</span><span class="s-lbl">פעולות</span></div>
    </div>

    <div class="block">
      <div class="lbl">מתן נקודות</div>
      <div class="circles" id="circles"></div>
    </div>

    <div class="block" id="takeBlock" hidden>
      <div class="lbl">הורדה · רק מורה</div>
      <div class="pills" id="pills"></div>
    </div>

    <div class="free-row">
      <input class="free num" id="free" type="number" inputmode="numeric" placeholder="סכום אחר" min="-20" max="20">
      <button class="go" id="freeGo" aria-label="שמור">←</button>
    </div>

    <div class="block">
      <div class="lbl">תנועות אחרונות</div>
      <ul class="hist" id="hist"></ul>
    </div>
  </aside>

  <!-- משמאל: כל הכיתה -->
  <main class="list">
    <div class="grid" id="grid" aria-live="polite"></div>
    <p class="empty" id="empty" hidden>אין תלמידים שתואמים את החיפוש.</p>
  </main>
</div>

<div class="undo" id="undo" hidden>
  <span class="h undo-text" id="undoText"></span>
  <button class="undo-btn h" id="undoBtn">בטל</button>
  <span class="undo-timer" id="undoTimer"></span>
</div>

<div class="toast" id="toast" hidden></div>

<script>window.CLASS_ID = <%= currentId %>; window.ROLE = "<%= actor.role %>"; window.CLASS_NAME = "<%= (classes.find(function(c){return c.id===currentId})||{}).name %>";</script>
<script src="/app.js"></script>
</body>
</html>
